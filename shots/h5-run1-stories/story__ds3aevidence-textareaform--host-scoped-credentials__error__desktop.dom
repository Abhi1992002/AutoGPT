<p id="radix-_r_2_">Dialog</p>
<div>
<div>
<p>Headers sent with every request to this host.</p>
<form>
<div>
<div>
<div>
<label for="host">
<span>Host Pattern</span>
</label>
</div>
<span>Enter the host/domain to match against request URLs (e.g., api.example.com).</span>
</div>
<div>
<div>
<input placeholder="Enter host (e.g., api.example.com)" id="host" type="text" value="" name="host" style="">
</div>
<span>  </span>
</div>
</div>
<div>
<label for="undefined-form-item">Headers</label>
<p id="undefined-form-item-description">Add sensitive headers (like Authorization, X-API-Key) that should be automatically included in requests to the specified host.</p>
<div>
<div>
<div>
<div>
<label for="header-0-key">
<span>Header Name</span>
</label>
</div>
</div>
<div>
<div>
<input placeholder="Header name (e.g., Authorization)" id="header-0-key" value="" style="">
</div>
<span>  </span>
</div>
</div>
<div>
<div>
<div>
<label for="header-0-value">
<span>Header Value</span>
</label>
</div>
</div>
<div>
<div>
<input placeholder="Header value (e.g., Bearer token123)" id="header-0-value" type="password" value="" style="">
<button type="button" aria-label="Show password" aria-pressed="false" aria-controls="header-0-value">
