<h2 id="radix-_r_1_">Add sensitive headers for HTTP</h2>
<button aria-label="Close">
<span>
<svg xmlns="http://www.w3.org/2000/svg" width="1rem" height="1em" viewBox="0 0 24 24" fill="none" color="currentColor" stroke-width="2" stroke="currentColor">
