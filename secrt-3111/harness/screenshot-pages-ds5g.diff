+// DS5g harness fixes (SECRT-3111), applied to every run alike:
+// - no element keeps focus and the mouse rests in the bottom-right corner,
+//   so focus-within / hover styles never depend on what loaded first;
+// - text is reshaped after the fonts load, and a 1px viewport resize and
+//   back forces a full relayout and repaint, so
+//   the final pixels do not depend on paint history (font swaps, iframes).
+async function neutralise(page: Page) {
+  for (const frame of page.frames()) await reshape(frame).catch(() => undefined);
+  const size = page.viewportSize();
+  if (size) {
+    await page.mouse.move(size.width - 1, size.height - 1);
+    await page.setViewportSize({ width: size.width, height: size.height + 1 });
+    await settle(page);
+    await page.setViewportSize(size);
+  }
+  await settle(page);
+}
+
+// Runs in every frame, artifact iframes included.
+async function reshape(frame: ReturnType<Page["mainFrame"]>) {
+  await frame.evaluate(async () => {
+    const active = document.activeElement as HTMLElement | null;
+    active?.blur?.();
+    // Reshape every text run once the web fonts are in: text first laid out
+    // before the font swap otherwise keeps decoration metrics (a dotted
+    // underline's dots) that vary from load to load.
+    await document.fonts.ready;
+    const style = document.createElement("style");
+    style.textContent = "*{letter-spacing:0.001px!important}";
+    document.head.appendChild(style);
+    await new Promise((done) =>
+      requestAnimationFrame(() => requestAnimationFrame(done)),
+    );
+    style.remove();
+    await new Promise((done) =>
+      requestAnimationFrame(() => requestAnimationFrame(done)),
+    );
+  });
+}
