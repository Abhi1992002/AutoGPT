[{"id":"welcome","title":"Welcome to AutoGPT Builder! 👋🏻","text":"\n      <div class=\"text-body text-foreground-emphasis\">\n        <p class=\"text-body font-normal text-foreground-emphasis m-0\">This interactive tutorial will teach you how to build your first AI workflow.</p>\n        <p class=\"text-body font-medium text-foreground-emphasis m-0\" style=\"margin-top: 0.75rem;\">You'll learn how to:</p>\n        <ul class=\"pl-2 text-body leading-5 pt-2\">\n          <li>- Add blocks to your workflow</li>\n          <li>- Understand block inputs and outputs</li>\n          <li>- Save and run your workflow</li>\n          <li>- and much more...</li>\n        </ul>\n        <p class=\"text-caption font-normal text-foreground-tertiary m-0\" style=\"margin-top: 0.75rem;\">Estimated time: 3-4 minutes</p>\n      </div>\n    ","buttons":[{"text":"Skip Tutorial","classes":"shepherd-button-secondary"},{"text":"Let's Begin","classes":""}]},{"id":"open-block-menu","title":"Open the Block Menu","text":"\n      <div class=\"text-body text-foreground-emphasis\">\n        <p class=\"text-body font-normal text-foreground-emphasis m-0\">Let's start by opening the Block Menu.</p>\n        \n  <div class=\"bg-accent-surface ring-1 ring-violet-200 rounded-2xl p-2 px-4 mt-2 flex items-start gap-2 text-body leading-5 font-medium text-violet-800 \">  \n    <span class=\"flex-shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"#52525b\" viewBox=\"0 0 256 256\"><path d=\"M88,24V16a8,8,0,0,1,16,0v8a8,8,0,0,1-16,0ZM16,104h8a8,8,0,0,0,0-16H16a8,8,0,0,0,0,16ZM124.42,39.16a8,8,0,0,0,10.74-3.58l8-16a8,8,0,0,0-14.31-7.16l-8,16A8,8,0,0,0,124.42,39.16Zm-96,81.69-16,8a8,8,0,0,0,7.16,14.31l16-8a8,8,0,1,0-7.16-14.31ZM219.31,184a16,16,0,0,1,0,22.63l-12.68,12.68a16,16,0,0,1-22.63,0L132.7,168,115,214.09c0,.1-.08.21-.13.32a15.83,15.83,0,0,1-14.6,9.59l-.79,0a15.83,15.83,0,0,1-14.41-11L32.8,52.92A16,16,0,0,1,52.92,32.8L213,85.07a16,16,0,0,1,1.41,29.8l-.32.13L168,132.69ZM208,195.31,156.69,144h0a16,16,0,0,1,4.93-26l.32-.14,45.95-17.64L48,48l52.2,159.86,17.65-46c0-.11.08-.22.13-.33a16,16,0,0,1,11.69-9.34,16.72,16.72,0,0,1,3-.28,16,16,0,0,1,11.3,4.69L195.31,208Z\"></path></svg></span>\n    <span>Click this button to open the menu</span>\n  </div>\n\n      </div>\n    ","buttons":[]},{"id":"block-menu-overview","title":"The Block Menu","text":"\n      <div class=\"text-body text-foreground-emphasis\">\n        <p class=\"text-body font-normal text-foreground-emphasis m-0\">This is the <strong>Block Menu</strong> — your toolbox for building workflows.</p>\n        <p class=\"text-body font-medium text-foreground-emphasis m-0\" style=\"margin-top: 0.5rem;\">Here you'll find:</p>\n        <ul>\n          <li><strong>Input Blocks</strong> — Entry points for data</li>\n          <li><strong>Action Blocks</strong> — Processing and AI operations</li>\n          <li><strong>Output Blocks</strong> — Results and responses</li>\n          <li><strong>Integrations</strong> — Third-party service blocks</li>\n          <li><strong>Library Workflows</strong> — Your personal workflows</li>\n          <li><strong>Marketplace Workflows</strong> — Community workflows</li>\n        </ul>\n      </div>\n    ","buttons":[{"text":"Next","classes":""}]},{"id":"search-calculator","title":"Search for a Block","text":"\n      <div class=\"text-body text-foreground-emphasis\">\n        <p class=\"text-body font-normal text-foreground-emphasis m-0\">Let's add a Calculator block to start.</p>\n        \n  <div class=\"bg-accent-surface ring-1 ring-violet-200 rounded-2xl p-2 px-4 mt-2 flex items-start gap-2 text-body leading-5 font-medium text-violet-800 \">  \n    <span class=\"flex-shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"#52525b\" viewBox=\"0 0 256 256\"><path d=\"M224,48H32A16,16,0,0,0,16,64V192a16,16,0,0,0,16,16H224a16,16,0,0,0,16-16V64A16,16,0,0,0,224,48Zm0,144H32V64H224V192Zm-16-64a8,8,0,0,1-8,8H56a8,8,0,0,1,0-16H200A8,8,0,0,1,208,128Zm0-32a8,8,0,0,1-8,8H56a8,8,0,0,1,0-16H200A8,8,0,0,1,208,96ZM72,160a8,8,0,0,1-8,8H56a8,8,0,0,1,0-16h8A8,8,0,0,1,72,160Zm96,0a8,8,0,0,1-8,8H96a8,8,0,0,1,0-16h64A8,8,0,0,1,168,160Zm40,0a8,8,0,0,1-8,8h-8a8,8,0,0,1,0-16h8A8,8,0,0,1,208,160Z\"></path></svg></span>\n    <span>Type Calculator in the search bar</span>\n  </div>\n\n        <p class=\"text-caption font-normal text-foreground-tertiary m-0\" style=\"margin-top: 0.5rem;\">The search will filter blocks as you type.</p>\n      </div>\n    ","buttons":[]},{"id":"select-calculator","title":"Add the Calculator Block","text":"\n      <div class=\"text-body text-foreground-emphasis\">\n        <p class=\"text-body font-normal text-foreground-emphasis m-0\">You should see the <strong>Calculator</strong> block in the results.</p>\n        \n  <div class=\"bg-accent-surface ring-1 ring-violet-200 rounded-2xl p-2 px-4 mt-2 flex items-start gap-2 text-body leading-5 font-medium text-violet-800 \">  \n    <span class=\"flex-shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"#52525b\" viewBox=\"0 0 256 256\"><path d=\"M88,24V16a8,8,0,0,1,16,0v8a8,8,0,0,1-16,0ZM16,104h8a8,8,0,0,0,0-16H16a8,8,0,0,0,0,16ZM124.42,39.16a8,8,0,0,0,10.74-3.58l8-16a8,8,0,0,0-14.31-7.16l-8,16A8,8,0,0,0,124.42,39.16Zm-96,81.69-16,8a8,8,0,0,0,7.16,14.31l16-8a8,8,0,1,0-7.16-14.31ZM219.31,184a16,16,0,0,1,0,22.63l-12.68,12.68a16,16,0,0,1-22.63,0L132.7,168,115,214.09c0,.1-.08.21-.13.32a15.83,15.83,0,0,1-14.6,9.59l-.79,0a15.83,15.83,0,0,1-14.41-11L32.8,52.92A16,16,0,0,1,52.92,32.8L213,85.07a16,16,0,0,1,1.41,29.8l-.32.13L168,132.69ZM208,195.31,156.69,144h0a16,16,0,0,1,4.93-26l.32-.14,45.95-17.64L48,48l52.2,159.86,17.65-46c0-.11.08-.22.13-.33a16,16,0,0,1,11.69-9.34,16.72,16.72,0,0,1,3-.28,16,16,0,0,1,11.3,4.69L195.31,208Z\"></path></svg></span>\n    <span>Click on the Calculator block to add it</span>\n  </div>\n\n        \n        <div class=\"bg-surface-hover ring-1 ring-border-base rounded-2xl p-2 px-4 mt-2 flex items-start gap-2 text-body leading-5 font-medium text-foreground-secondary\">  \n          <span class=\"flex-shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"#52525b\" viewBox=\"0 0 256 256\"><path d=\"M188,80a27.79,27.79,0,0,0-13.36,3.4,28,28,0,0,0-46.64-11A28,28,0,0,0,80,92v20H68a28,28,0,0,0-28,28v12a88,88,0,0,0,176,0V108A28,28,0,0,0,188,80Zm12,72a72,72,0,0,1-144,0V140a12,12,0,0,1,12-12H80v24a8,8,0,0,0,16,0V92a12,12,0,0,1,24,0v28a8,8,0,0,0,16,0V92a12,12,0,0,1,24,0v28a8,8,0,0,0,16,0V108a12,12,0,0,1,24,0Z\"></path></svg></span>\n          <span>You can also drag blocks onto the canvas</span>\n        </div>\n      </div>\n    ","buttons":[]},{"id":"focus-new-block","title":"Your First Block!","text":"\n      <div class=\"text-body text-foreground-emphasis\">\n        <p class=\"text-body font-normal text-foreground-emphasis m-0\">Excellent! This is your <strong>Calculator Block</strong>.</p>\n        <p class=\"text-body font-normal text-foreground-emphasis m-0\" style=\"margin-top: 0.5rem;\">Let's explore how blocks work.</p>\n      </div>\n    ","buttons":[{"text":"Show me","classes":""}]},{"id":"input-handles","title":"Input Handles","text":"\n      <div class=\"text-body text-foreground-emphasis\">\n        <p class=\"text-body font-normal text-foreground-emphasis m-0\">On the <strong>left side</strong> of the block are <strong>input handles</strong>.</p>\n        <p class=\"text-body font-normal text-foreground-emphasis m-0\" style=\"margin-top: 0.5rem;\">These are where data flows <em>into</em> the block from other blocks.</p>\n      </div>\n    ","buttons":[{"text":"Back","classes":"shepherd-button-secondary"},{"text":"Next","classes":""}]},{"id":"output-handles","title":"Output Handles","text":"\n      <div class=\"text-body text-foreground-emphasis\">\n        <p class=\"text-body font-normal text-foreground-emphasis m-0\">On the <strong>right side</strong> is the <strong>output handle</strong>.</p>\n        <p class=\"text-body font-normal text-foreground-emphasis m-0\" style=\"margin-top: 0.5rem;\">This is where the result flows <em>out</em> to connect to other blocks.</p>\n        \n  <div class=\"bg-info-surface ring-1 ring-blue-200 rounded-2xl p-2 px-4 mt-2 flex items-start gap-2 text-body leading-5 font-medium text-blue-800 \">  \n    <span class=\"flex-shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"#52525b\" viewBox=\"0 0 256 256\"><path d=\"M188,80a27.79,27.79,0,0,0-13.36,3.4,28,28,0,0,0-46.64-11A28,28,0,0,0,80,92v20H68a28,28,0,0,0-28,28v12a88,88,0,0,0,176,0V108A28,28,0,0,0,188,80Zm12,72a72,72,0,0,1-144,0V140a12,12,0,0,1,12-12H80v24a8,8,0,0,0,16,0V92a12,12,0,0,1,24,0v28a8,8,0,0,0,16,0V92a12,12,0,0,1,24,0v28a8,8,0,0,0,16,0V108a12,12,0,0,1,24,0Z\"></path></svg></span>\n    <span>You can drag from output to input handler to connect blocks</span>\n  </div>\n\n      </div>\n    ","buttons":[{"text":"Back","classes":"shepherd-button-secondary"},{"text":"Next →","classes":""}]},{"id":"enter-values","title":"Enter Values","text":"\n      <div class=\"text-body text-foreground-emphasis\">\n        <p class=\"text-body font-normal text-foreground-emphasis m-0\">Now let's configure the block with actual values.</p>\n        \n  <div id=\"requirements-box\" class=\"mt-3 p-3 bg-warning-surface ring-1 ring-warning-border rounded-2xl\">\n    <p id=\"requirements-title\" class=\"text-body leading-5 font-medium text-amber-600 m-0 mb-2\">⚠️ Required to continue:</p>\n    <ul id=\"requirements-list\" class=\"text-body-sm leading-inherit text-amber-600 m-0 pl-4 space-y-1\">\n      <li id=\"req-a\" class=\"flex items-center gap-2\">\n        <span class=\"req-icon\">○</span> Enter a number in field <strong>A</strong> (e.g., 10)\n      </li>\n      <li id=\"req-b\" class=\"flex items-center gap-2\">\n        <span class=\"req-icon\">○</span> Enter a number in field <strong>B</strong> (e.g., 5)\n      </li>\n      <li id=\"req-op\" class=\"flex items-center gap-2\">\n        <span class=\"req-icon\">○</span> Select an <strong>Operation</strong> (Add, Multiply, etc.)\n      </li>\n    </ul>\n  </div>\n\n        \n  <div class=\"bg-accent-surface ring-1 ring-violet-200 rounded-2xl p-2 px-4 mt-2 flex items-start gap-2 text-body leading-5 font-medium text-violet-800 \">  \n    <span class=\"flex-shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"#52525b\" viewBox=\"0 0 256 256\"><path d=\"M88,24V16a8,8,0,0,1,16,0v8a8,8,0,0,1-16,0ZM16,104h8a8,8,0,0,0,0-16H16a8,8,0,0,0,0,16ZM124.42,39.16a8,8,0,0,0,10.74-3.58l8-16a8,8,0,0,0-14.31-7.16l-8,16A8,8,0,0,0,124.42,39.16Zm-96,81.69-16,8a8,8,0,0,0,7.16,14.31l16-8a8,8,0,1,0-7.16-14.31ZM219.31,184a16,16,0,0,1,0,22.63l-12.68,12.68a16,16,0,0,1-22.63,0L132.7,168,115,214.09c0,.1-.08.21-.13.32a15.83,15.83,0,0,1-14.6,9.59l-.79,0a15.83,15.83,0,0,1-14.41-11L32.8,52.92A16,16,0,0,1,52.92,32.8L213,85.07a16,16,0,0,1,1.41,29.8l-.32.13L168,132.69ZM208,195.31,156.69,144h0a16,16,0,0,1,4.93-26l.32-.14,45.95-17.64L48,48l52.2,159.86,17.65-46c0-.11.08-.22.13-.33a16,16,0,0,1,11.69-9.34,16.72,16.72,0,0,1,3-.28,16,16,0,0,1,11.3,4.69L195.31,208Z\"></path></svg></span>\n    <span>Fill in all the required fields above</span>\n  </div>\n\n      </div>\n    ","buttons":[{"text":"Back","classes":"shepherd-button-secondary"},{"text":"Continue","classes":"shepherd-button-primary"}]},{"id":"adding-second-calculator","title":"Adding Second Calculator","text":"\n      <div class=\"text-body text-foreground-emphasis\">\n        <p class=\"text-body font-normal text-foreground-emphasis m-0\">Great job configuring the first Calculator!</p>\n        <p class=\"text-body font-normal text-foreground-emphasis m-0\" style=\"margin-top: 0.5rem;\">Now let's add a <strong>second Calculator block</strong> and connect them together.</p>\n        \n        <div class=\"mt-3 p-3 bg-info-surface ring-1 ring-blue-200 rounded-2xl\">\n          <p class=\"text-body leading-5 font-medium text-info-foreground m-0 mb-1\">We'll create a chain:</p>\n          <p class=\"text-body-sm leading-inherit text-info-foreground m-0\">Calculator 1 → Calculator 2</p>\n          <p class=\"text-caption leading-inherit text-info m-0 mt-1 italic\">The output of the first will feed into the second!</p>\n        </div>\n      </div>\n    ","buttons":[{"text":"Back","classes":"shepherd-button-secondary"},{"text":"Add Second Calculator","classes":""}]},{"id":"second-calculator-added","title":"Second Calculator Added! ✅","text":"\n      <div class=\"text-body text-foreground-emphasis\">\n        <p class=\"text-body font-normal text-foreground-emphasis m-0\">I've added a <strong>second Calculator block</strong> to your canvas.</p>\n        <p class=\"text-body font-normal text-foreground-emphasis m-0\" style=\"margin-top: 0.5rem;\">Now let's configure it and connect them together.</p>\n        \n        <div class=\"mt-3 p-3 bg-success-surface ring-1 ring-green-200 rounded-2xl\">\n          <p class=\"text-body leading-5 font-medium text-success m-0\">You now have 2 Calculator blocks!</p>\n        </div>\n      </div>\n    ","buttons":[{"text":"Let's configure it","classes":""}]},{"id":"configure-second-calculator","title":"Configure Second Calculator","text":"\n      <div class=\"text-body text-foreground-emphasis\">\n        <p class=\"text-body font-normal text-foreground-emphasis m-0\">Now configure the <strong>second Calculator block</strong>.</p>\n        \n  <div id=\"second-calc-requirements-box\" class=\"mt-3 p-3 bg-warning-surface ring-1 ring-warning-border rounded-2xl\">\n    <p id=\"second-calc-requirements-title\" class=\"text-body leading-5 font-medium text-amber-600 m-0 mb-2\">⚠️ Required to continue:</p>\n    <ul id=\"second-calc-requirements-list\" class=\"text-body-sm leading-inherit text-amber-600 m-0 pl-4 space-y-1\">\n      <li id=\"req2-b\" class=\"flex items-center gap-2\">\n        <span class=\"req-icon\">○</span> Enter a number in field <strong>B</strong> (e.g., 2)\n      </li>\n      <li id=\"req2-op\" class=\"flex items-center gap-2\">\n        <span class=\"req-icon\">○</span> Select an <strong>Operation</strong> (e.g., Multiply)\n      </li>\n    </ul>\n    <p class=\"text-caption leading-inherit text-warning m-0 mt-2 italic\">Note: Field A will be connected from the first Calculator's output</p>\n  </div>\n\n        \n  <div class=\"bg-accent-surface ring-1 ring-violet-200 rounded-2xl p-2 px-4 mt-2 flex items-start gap-2 text-body leading-5 font-medium text-violet-800 \">  \n    <span class=\"flex-shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"#52525b\" viewBox=\"0 0 256 256\"><path d=\"M88,24V16a8,8,0,0,1,16,0v8a8,8,0,0,1-16,0ZM16,104h8a8,8,0,0,0,0-16H16a8,8,0,0,0,0,16ZM124.42,39.16a8,8,0,0,0,10.74-3.58l8-16a8,8,0,0,0-14.31-7.16l-8,16A8,8,0,0,0,124.42,39.16Zm-96,81.69-16,8a8,8,0,0,0,7.16,14.31l16-8a8,8,0,1,0-7.16-14.31ZM219.31,184a16,16,0,0,1,0,22.63l-12.68,12.68a16,16,0,0,1-22.63,0L132.7,168,115,214.09c0,.1-.08.21-.13.32a15.83,15.83,0,0,1-14.6,9.59l-.79,0a15.83,15.83,0,0,1-14.41-11L32.8,52.92A16,16,0,0,1,52.92,32.8L213,85.07a16,16,0,0,1,1.41,29.8l-.32.13L168,132.69ZM208,195.31,156.69,144h0a16,16,0,0,1,4.93-26l.32-.14,45.95-17.64L48,48l52.2,159.86,17.65-46c0-.11.08-.22.13-.33a16,16,0,0,1,11.69-9.34,16.72,16.72,0,0,1,3-.28,16,16,0,0,1,11.3,4.69L195.31,208Z\"></path></svg></span>\n    <span>Fill in field B and select an Operation</span>\n  </div>\n\n      </div>\n    ","buttons":[{"text":"Back","classes":"shepherd-button-secondary"},{"text":"Continue","classes":"shepherd-button-primary"}]},{"id":"connect-blocks-output","title":"Connect the Blocks: Output","text":"\n        <div class=\"text-body text-foreground-emphasis\">\n          <p class=\"text-body font-normal text-foreground-emphasis m-0\">Now, let's connect the <strong>Result output</strong> of the first Calculator to the <strong>input (A)</strong> of the second Calculator.</p>\n          \n          <div class=\"mt-3 p-3 bg-info-surface ring-1 ring-blue-200 rounded-2xl\">\n            <p class=\"text-body leading-5 font-medium text-info-foreground m-0 mb-2\">Drag from the Result output:</p>\n            <p class=\"text-body-sm leading-inherit text-info-foreground m-0\">Click and drag from the <strong>Result</strong> output pin (right side) of the <strong>first Calculator block</strong>.</p>\n          </div>\n          \n  <div id=\"connection-status-output\" class=\"mt-3 p-2 bg-warning-surface ring-1 ring-warning-border rounded-2xl text-center text-body leading-5 text-amber-600\">\n    Waiting for connection...\n  </div>\n\n          \n  <div class=\"bg-accent-surface ring-1 ring-violet-200 rounded-2xl p-2 px-4 mt-2 flex items-start gap-2 text-body leading-5 font-medium text-violet-800 \">  \n    <span class=\"flex-shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"#52525b\" viewBox=\"0 0 256 256\"><path d=\"M188,80a27.79,27.79,0,0,0-13.36,3.4,28,28,0,0,0-46.64-11A28,28,0,0,0,80,92v20H68a28,28,0,0,0-28,28v12a88,88,0,0,0,176,0V108A28,28,0,0,0,188,80Zm12,72a72,72,0,0,1-144,0V140a12,12,0,0,1,12-12H80v24a8,8,0,0,0,16,0V92a12,12,0,0,1,24,0v28a8,8,0,0,0,16,0V92a12,12,0,0,1,24,0v28a8,8,0,0,0,16,0V108a12,12,0,0,1,24,0Z\"></path></svg></span>\n    <span>Drag from the Result output pin</span>\n  </div>\n\n        </div>\n      ","buttons":[{"text":"Back","classes":"shepherd-button-secondary"},{"text":"Skip (already connected)","classes":"shepherd-button-secondary"}]},{"id":"connect-blocks-input","title":"Connect the Blocks: Input","text":"\n        <div class=\"text-body text-foreground-emphasis\">\n          <p class=\"text-body font-normal text-foreground-emphasis m-0\">Now, connect to the <strong>input (A)</strong> of the second Calculator block.</p>\n          \n          <div class=\"mt-3 p-3 bg-info-surface ring-1 ring-blue-200 rounded-2xl\">\n            <p class=\"text-body leading-5 font-medium text-info-foreground m-0 mb-2\">Drop on the A input:</p>\n            <p class=\"text-body-sm leading-inherit text-info-foreground m-0\">Drag to the <strong>A</strong> input handle (left side) of the <strong>second Calculator block</strong>.</p>\n          </div>\n          \n  <div id=\"connection-status-input\" class=\"mt-3 p-2 bg-warning-surface ring-1 ring-warning-border rounded-2xl text-center text-body leading-5 text-amber-600\">\n    Waiting for connection...\n  </div>\n\n        </div>\n      ","buttons":[{"text":"Back","classes":"shepherd-button-secondary"},{"text":"Skip (already connected)","classes":"shepherd-button-secondary"}]},{"id":"connection-complete","title":"Blocks Connected! 🎉","text":"\n        <div class=\"text-body text-foreground-emphasis\">\n          <p class=\"text-body font-normal text-foreground-emphasis m-0\">Excellent! Your Calculator blocks are now connected:</p>\n          \n          <div class=\"mt-3 p-3 bg-success-surface ring-1 ring-green-200 rounded-2xl\">\n            <div class=\"flex items-center justify-center gap-2 text-body leading-5 font-medium text-success\">\n              <span>Calculator 1</span>\n              <span>→</span>\n              <span>Calculator 2</span>\n            </div>\n            <p class=\"text-caption leading-inherit text-green-500 m-0 mt-2 text-center italic\">The result of Calculator 1 flows into Calculator 2's input A</p>\n          </div>\n          \n          <p class=\"text-body font-normal text-foreground-emphasis m-0\" style=\"margin-top: 0.75rem;\">Now let's save and run your workflow!</p>\n        </div>\n      ","buttons":[{"text":"Save My Workflow","classes":""}]},{"id":"open-save","title":"Save Your Workflow","text":"\n      <div class=\"text-body text-foreground-emphasis\">\n        <p class=\"text-body font-normal text-foreground-emphasis m-0\">Before running, we need to <strong>save</strong> your workflow.</p>\n        \n  <div class=\"bg-accent-surface ring-1 ring-violet-200 rounded-2xl p-2 px-4 mt-2 flex items-start gap-2 text-body leading-5 font-medium text-violet-800 \">  \n    <span class=\"flex-shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"#52525b\" viewBox=\"0 0 256 256\"><path d=\"M88,24V16a8,8,0,0,1,16,0v8a8,8,0,0,1-16,0ZM16,104h8a8,8,0,0,0,0-16H16a8,8,0,0,0,0,16ZM124.42,39.16a8,8,0,0,0,10.74-3.58l8-16a8,8,0,0,0-14.31-7.16l-8,16A8,8,0,0,0,124.42,39.16Zm-96,81.69-16,8a8,8,0,0,0,7.16,14.31l16-8a8,8,0,1,0-7.16-14.31ZM219.31,184a16,16,0,0,1,0,22.63l-12.68,12.68a16,16,0,0,1-22.63,0L132.7,168,115,214.09c0,.1-.08.21-.13.32a15.83,15.83,0,0,1-14.6,9.59l-.79,0a15.83,15.83,0,0,1-14.41-11L32.8,52.92A16,16,0,0,1,52.92,32.8L213,85.07a16,16,0,0,1,1.41,29.8l-.32.13L168,132.69ZM208,195.31,156.69,144h0a16,16,0,0,1,4.93-26l.32-.14,45.95-17.64L48,48l52.2,159.86,17.65-46c0-.11.08-.22.13-.33a16,16,0,0,1,11.69-9.34,16.72,16.72,0,0,1,3-.28,16,16,0,0,1,11.3,4.69L195.31,208Z\"></path></svg></span>\n    <span>Click the Save button</span>\n  </div>\n\n      </div>\n    ","buttons":[]},{"id":"save-details","title":"Name Your Workflow","text":"\n      <div class=\"text-body text-foreground-emphasis\">\n        <p class=\"text-body font-normal text-foreground-emphasis m-0\">Give your workflow a <strong>name</strong> and optional description.</p>\n        \n  <div class=\"bg-accent-surface ring-1 ring-violet-200 rounded-2xl p-2 px-4 mt-2 flex items-start gap-2 text-body leading-5 font-medium text-violet-800 \">  \n    <span class=\"flex-shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"#52525b\" viewBox=\"0 0 256 256\"><path d=\"M88,24V16a8,8,0,0,1,16,0v8a8,8,0,0,1-16,0ZM16,104h8a8,8,0,0,0,0-16H16a8,8,0,0,0,0,16ZM124.42,39.16a8,8,0,0,0,10.74-3.58l8-16a8,8,0,0,0-14.31-7.16l-8,16A8,8,0,0,0,124.42,39.16Zm-96,81.69-16,8a8,8,0,0,0,7.16,14.31l16-8a8,8,0,1,0-7.16-14.31ZM219.31,184a16,16,0,0,1,0,22.63l-12.68,12.68a16,16,0,0,1-22.63,0L132.7,168,115,214.09c0,.1-.08.21-.13.32a15.83,15.83,0,0,1-14.6,9.59l-.79,0a15.83,15.83,0,0,1-14.41-11L32.8,52.92A16,16,0,0,1,52.92,32.8L213,85.07a16,16,0,0,1,1.41,29.8l-.32.13L168,132.69ZM208,195.31,156.69,144h0a16,16,0,0,1,4.93-26l.32-.14,45.95-17.64L48,48l52.2,159.86,17.65-46c0-.11.08-.22.13-.33a16,16,0,0,1,11.69-9.34,16.72,16.72,0,0,1,3-.28,16,16,0,0,1,11.3,4.69L195.31,208Z\"></path></svg></span>\n    <span>Enter a name and click \"Save Workflow\"</span>\n  </div>\n\n        <p class=\"text-caption font-normal text-foreground-tertiary m-0\" style=\"margin-top: 0.5rem;\">Example: \"My Calculator Workflow\"</p>\n      </div>\n    ","buttons":[]},{"id":"press-run","title":"Run Your Workflow","text":"\n      <div class=\"text-body text-foreground-emphasis\">\n        <p class=\"text-body font-normal text-foreground-emphasis m-0\">Your workflow is saved and ready! Now let's <strong>run it</strong> to see it in action.</p>\n        \n  <div class=\"bg-accent-surface ring-1 ring-violet-200 rounded-2xl p-2 px-4 mt-2 flex items-start gap-2 text-body leading-5 font-medium text-violet-800 \">  \n    <span class=\"flex-shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"#52525b\" viewBox=\"0 0 256 256\"><path d=\"M88,24V16a8,8,0,0,1,16,0v8a8,8,0,0,1-16,0ZM16,104h8a8,8,0,0,0,0-16H16a8,8,0,0,0,0,16ZM124.42,39.16a8,8,0,0,0,10.74-3.58l8-16a8,8,0,0,0-14.31-7.16l-8,16A8,8,0,0,0,124.42,39.16Zm-96,81.69-16,8a8,8,0,0,0,7.16,14.31l16-8a8,8,0,1,0-7.16-14.31ZM219.31,184a16,16,0,0,1,0,22.63l-12.68,12.68a16,16,0,0,1-22.63,0L132.7,168,115,214.09c0,.1-.08.21-.13.32a15.83,15.83,0,0,1-14.6,9.59l-.79,0a15.83,15.83,0,0,1-14.41-11L32.8,52.92A16,16,0,0,1,52.92,32.8L213,85.07a16,16,0,0,1,1.41,29.8l-.32.13L168,132.69ZM208,195.31,156.69,144h0a16,16,0,0,1,4.93-26l.32-.14,45.95-17.64L48,48l52.2,159.86,17.65-46c0-.11.08-.22.13-.33a16,16,0,0,1,11.69-9.34,16.72,16.72,0,0,1,3-.28,16,16,0,0,1,11.3,4.69L195.31,208Z\"></path></svg></span>\n    <span>Click the Run button</span>\n  </div>\n\n      </div>\n    ","buttons":[]},{"id":"show-output","title":"View the Output","text":"\n      <div class=\"text-body text-foreground-emphasis\">\n        <p class=\"text-body font-normal text-foreground-emphasis m-0\">Here's the <strong>output</strong> of your block!</p>\n        \n        <div class=\"mt-3 p-3 bg-info-surface ring-1 ring-blue-200 rounded-2xl\">\n          <p class=\"text-body leading-5 font-medium text-info-foreground m-0\">Latest Output:</p>\n          <p class=\"text-body-sm leading-inherit text-info-foreground m-0 mt-1\">After each run, you can see the result of each block at the bottom of the block.</p>\n        </div>\n        \n        <div class=\"mt-2 p-2 bg-surface-hover ring-1 ring-border-base rounded-xl\">\n          <p class=\"text-body-sm leading-inherit text-foreground-secondary m-0\">The output shows:</p>\n          <ul class=\"text-body-sm leading-inherit text-foreground-tertiary m-0 mt-1 pl-4\">\n            <li>• The calculated result</li>\n            <li>• Execution timestamp</li>\n          </ul>\n        </div>\n      </div>\n    ","buttons":[{"text":"Finish Tutorial","classes":""}]},{"id":"congratulations","title":"Congratulations! 🎉","text":"\n      <div class=\"text-body text-foreground-emphasis\">\n        <p class=\"text-body font-normal text-foreground-emphasis m-0\">You have successfully created and run your first workflow!</p>\n        \n        <div class=\"mt-3 p-3 bg-success-surface ring-1 ring-green-200 rounded-2xl\">\n          <p class=\"text-body leading-5 font-medium text-success m-0\">You learned how to:</p>\n          <ul class=\"text-body-sm leading-inherit text-success m-0 pl-4 mt-2 space-y-1\">\n            <li>• Add blocks from the Block Menu</li>\n            <li>• Understand input and output handles</li>\n            <li>• Configure block values</li>\n            <li>• Connect blocks together</li>\n            <li>• Save and run your workflow</li>\n            <li>• View execution status and output</li>\n          </ul>\n        </div>\n        \n        <p class=\"text-body font-medium text-foreground-emphasis m-0\" style=\"margin-top: 0.75rem;\">Happy building! 🚀</p>\n      </div>\n    ","buttons":[{"text":"Restart Tutorial","classes":"shepherd-button-secondary"},{"text":"Finish","classes":""}]}]
